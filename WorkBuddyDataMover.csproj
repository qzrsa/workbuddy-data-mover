<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WorkBuddyDataMover</AssemblyName>
    <RootNamespace>WorkBuddyDataMover</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <CodePage>65001</CodePage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>WorkBuddy 数据目录迁移工具</Product>
    <AssemblyTitle>WorkBuddy 数据目录迁移工具</AssemblyTitle>
    <Company>WorkBuddyDataMover</Company>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ 下是构建期小工具，不参与主程序编译 -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="WorkBuddyDataMover.app.ico" />
  </ItemGroup>

</Project>
